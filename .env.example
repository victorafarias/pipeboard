# Meta App credentials (Meta Ads MCP + Meta Posts MCP)
# Create an app at https://developers.facebook.com/apps/
# For organic Facebook/Instagram posts, the user token needs:
# pages_show_list, pages_manage_posts, instagram_basic, instagram_content_publish
# Generate a token locally: python -m meta_posts_mcp --login
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Ads API (self-hosted MCP)
# Developer token: Google Ads → Tools → API Center
# OAuth client: Google Cloud Console → APIs & Services → Credentials
# Generate a refresh token locally: python -m google_ads_mcp --login
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC / manager account ID without dashes (optional)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# Google Analytics Admin + Data APIs (self-hosted MCP)
# Enable APIs: Google Analytics Admin API and Google Analytics Data API
# OAuth client: Google Cloud Console → APIs & Services → Credentials
# Scope: https://www.googleapis.com/auth/analytics.readonly
# Generate a refresh token locally: python -m google_analytics_mcp --login
# Extra packages: google-analytics-data google-analytics-admin google-auth
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# TikTok Marketing API (self-hosted MCP)
# App: https://business-api.tiktok.com/
# Generate tokens locally: python -m tiktok_ads_mcp --login
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
